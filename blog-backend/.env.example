 #DATABASE_URL	MySQL 连接串，必须改成你自己的用户名和密码
 #ALLOWED_ORIGINS	允许跨域的前端地址，多个用逗号分隔
 #SESSION_EXPIRE_DAYS	登录后 Session 保持 7 天
 #MEDIA_ROOT	媒体文件根目录
 #MUSIC_DIR	音乐监控目录，watchdog 监听这里
 #COVER_DIR	封面图目录
 #PHOTO_DIR	图片墙文件目录
 #DEBUG	开发阶段设为 True，方便看报错

# ============================================================
#  使用方式：复制本文件为 .env 并填入真实值
#      cp .env.example .env
#  .env 已被 .gitignore 忽略，不会提交到 GitHub
# ============================================================

# ===== 数据库连接 =====
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://用户名:密码@localhost:3306/personal_blog?charset=utf8mb4

# ===== 跨域允许来源（前端地址）=====
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Session 有效期（天）=====
SESSION_EXPIRE_DAYS=7

# ===== 媒体目录（相对 blog-backend 根目录）=====
MEDIA_ROOT=media
MUSIC_DIR=media/music
COVER_DIR=media/covers
PHOTO_DIR=media/photos
THUMB_DIR=media/thumbs

# ===== 调试模式 =====
DEBUG=True

PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# ===== 前后端地址（OAuth 回跳用）=====
# FRONTEND_URL：GitHub 登录完成后跳回哪里
# BACKEND_URL ：后端对外的地址，必须与 GitHub OAuth App 里填的回调一致
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ===== GitHub OAuth（访客登录评论用）=====
# ⚠️ 这两个是**你自己的**凭据，不会随仓库提供，必须自己申请：
#   1. 打开 https://github.com/settings/developers → OAuth Apps → New OAuth App
#   2. Application name 随便填，例如 personal-blog
#   3. Homepage URL 填前端地址，如 http://localhost:3000
#   4. Authorization callback URL 必须填：
#          http://localhost:8000/api/comments/github/callback
#      （即 BACKEND_URL + /api/comments/github/callback，必须完全一致）
#   5. 创建后复制 Client ID，再 Generate a new client secret 拿 Secret
# 注意：要建 **OAuth App**，不要建 GitHub App —— 两者的换 token 端点不同，
#       用错会报 incorrect_client_credentials。
# 两个都留空时，评论列表仍可浏览，但点「GitHub 登录」会返回 503。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- 网络受限时的开关（先跑 scripts/diagnose_github_net.py 判断）----
#
# 如果你需要走代理才能访问 GitHub，就填这一项（留空 = 不用代理）：
#     GITHUB_PROXY=http://127.0.0.1:端口
#
# 为什么不能只靠系统代理：httpx **不会**读取 Windows 系统代理或 PAC 脚本。
# 如果你的浏览器是靠 PAC / 系统代理访问 GitHub 的，后端必须在这里显式指定，
# 否则后端会直连 github.com 而超时（表现为点登录后报"连接 GitHub 失败"）。
# 用这一项的好处：只影响 GitHub 请求，本机 MySQL/接口不受影响，无需配 NO_PROXY。
# 具体端口看你的代理软件（Clash 常见 7890，v2rayN 常见 10809），
# 诊断脚本会列出本机正在监听的端口。
#
# 关于证书：本机加速器通常做 HTTPS 中间人（用自签证书替换 GitHub 证书）。
# 浏览器信任它，但 Python 默认只用 certifi 库，会报 CERTIFICATE_VERIFY_FAILED。
# 本项目已自动把 **操作系统证书存储** 里的证书一并载入（见
# app/services/github_oauth.py 的 _ssl_context），所以此时**无需**关闭校验。
GITHUB_PROXY=

# 访问 GitHub 的超时（秒）
GITHUB_TIMEOUT=20

# 一般不用改。若你的网络对 github.com 与 api.github.com 的封锁情况不同，
# 可用这两个覆盖（先看诊断脚本输出再决定）。
# GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_API_USER_URL=https://api.github.com/user

# ===== 访客登录态有效期（天）=====
COMMENTER_SESSION_DAYS=30

# ===== Cookie 安全策略 =====
# 本地开发（http://localhost 跨端口，属同站）：保持 lax / false
# 生产环境前后端不同域时改成：
#     COOKIE_SAMESITE=none
#     COOKIE_SECURE=true      （必须配合 HTTPS）
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ===== 网易云 Cookie =====
# 从浏览器开发者工具里复制 MUSIC_U 的值；留空则后台音乐功能不启用。
# 注意：这等同于账号凭据，绝不要提交到 Git。
NETEASE_MUSIC_U=
